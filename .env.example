# Supabase (Project Settings -> API). Without these the app runs in local demo mode
# (data stays in this browser only, no sharing between devices).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# LLM used to normalise imported recipes (ingredients, time split, timers, bullet points).
# Without a key the importer falls back to built-in heuristics.
# groq (default, free tier: https://console.groq.com/keys) | google | openrouter | ollama
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
